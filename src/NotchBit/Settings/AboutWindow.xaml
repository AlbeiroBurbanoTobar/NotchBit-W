<?xml version="1.0" encoding="utf-8"?>
<Window
    x:Class="NotchBit.Settings.AboutWindow"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    Title="Acerca de NotchBit">

    <StackPanel
        Padding="32"
        Spacing="10"
        HorizontalAlignment="Center"
        VerticalAlignment="Center">
        <Image
            Source="ms-appx:///Assets/NotchBit.png"
            Width="72"
            Height="72"
            HorizontalAlignment="Center" />
        <TextBlock
            Text="NotchBit"
            Style="{StaticResource TitleTextBlockStyle}"
            HorizontalAlignment="Center" />
        <TextBlock x:Name="VersionText" Opacity="0.7" HorizontalAlignment="Center" />
        <TextBlock
            Text="Una isla flotante en el borde superior de la pantalla: lo que suena ahora y una estantería para tus archivos."
            TextWrapping="Wrap"
            TextAlignment="Center"
            MaxWidth="320"
            Margin="0,6,0,0" />
        <StackPanel Spacing="0" Margin="0,10,0,0" HorizontalAlignment="Center">
            <TextBlock
                Text="Desarrollado por"
                Opacity="0.7"
                FontSize="12"
                HorizontalAlignment="Center" />
            <TextBlock
                Text="Albeiro J. Burbano Tobar"
                FontWeight="SemiBold"
                HorizontalAlignment="Center" />
            <TextBlock
                Text="Alicosoft"
                Opacity="0.7"
                HorizontalAlignment="Center" />
            <HyperlinkButton
                Content="alicosoft.dev"
                NavigateUri="https://alicosoft.dev"
                HorizontalAlignment="Center" />
        </StackPanel>
    </StackPanel>
</Window>
