<?xml version="1.0" encoding="utf-8"?>
<Window
    x:Class="NotchBit.Settings.SettingsWindow"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    Title="Ajustes de NotchBit">

    <ScrollViewer>
        <StackPanel Padding="28,24,28,28" Spacing="6" MaxWidth="560" HorizontalAlignment="Stretch">
            <TextBlock Text="Ajustes" Style="{StaticResource TitleTextBlockStyle}" Margin="0,0,0,12" />

            <TextBlock Text="General" Style="{StaticResource BodyStrongTextBlockStyle}" Margin="0,4,0,4" />
            <Border Style="{StaticResource CardStyle}">
                <ToggleSwitch
                    x:Name="StartupSwitch"
                    Header="Abrir al iniciar sesión"
                    OnContent="Activado"
                    OffContent="Desactivado"
                    Toggled="StartupSwitch_Toggled" />
            </Border>

            <TextBlock Text="Módulos" Style="{StaticResource BodyStrongTextBlockStyle}" Margin="0,16,0,4" />
            <TextBlock
                Text="Los módulos desactivados no aparecen como pestaña en la isla."
                Opacity="0.7"
                TextWrapping="Wrap"
                Margin="0,0,0,4" />
            <StackPanel x:Name="ModulesPanel" Spacing="6" />
        </StackPanel>
    </ScrollViewer>
</Window>
