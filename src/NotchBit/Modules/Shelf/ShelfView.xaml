<?xml version="1.0" encoding="utf-8"?>
<UserControl
    x:Class="NotchBit.Modules.Shelf.ShelfView"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:muxc="using:Microsoft.UI.Xaml.Controls"
    xmlns:local="using:NotchBit.Modules.Shelf">

    <Grid RowSpacing="4">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <Grid x:Name="Header" Visibility="Collapsed">
            <TextBlock x:Name="CountText" VerticalAlignment="Center" FontSize="12" Opacity="0.6" />
            <HyperlinkButton
                x:Name="ClearButton"
                HorizontalAlignment="Right"
                Padding="4,0"
                FontSize="12"
                Content="Vaciar"
                Click="Clear_Click" />
        </Grid>

        <TextBlock
            x:Name="EmptyText"
            Grid.Row="1"
            VerticalAlignment="Center"
            Opacity="0.6"
            TextWrapping="Wrap"
            Text="Suelta archivos sobre la isla para tenerlos a mano. Arrástralos fuera para copiarlos; los originales no se mueven." />

        <!-- Pressing on empty space here and dragging draws a selection rectangle. -->
        <ScrollViewer
            x:Name="TileScroller"
            Grid.Row="1"
            Background="Transparent"
            HorizontalScrollMode="Disabled"
            VerticalScrollBarVisibility="Auto">
            <muxc:ItemsRepeater x:Name="Repeater">
                <muxc:ItemsRepeater.Layout>
                    <muxc:UniformGridLayout
                        MinItemWidth="88"
                        MinItemHeight="84"
                        MinRowSpacing="4"
                        MinColumnSpacing="4"
                        ItemsStretch="None" />
                </muxc:ItemsRepeater.Layout>
                <muxc:ItemsRepeater.ItemTemplate>
                    <DataTemplate x:DataType="local:ShelfItem">
                        <Grid
                            Width="88"
                            Height="84"
                            CornerRadius="8"
                            Background="{x:Bind TileBackground, Mode=OneWay}"
                            CanDrag="True"
                            Tag="{x:Bind}"
                            Opacity="{x:Bind TileOpacity, Mode=OneWay}"
                            ToolTipService.ToolTip="{x:Bind ToolTip, Mode=OneWay}"
                            DragStarting="Tile_DragStarting"
                            Tapped="Tile_Tapped"
                            DoubleTapped="Tile_DoubleTapped"
                            PointerEntered="Tile_PointerEntered"
                            PointerExited="Tile_PointerExited">
                            <Grid.ContextFlyout>
                                <MenuFlyout>
                                    <MenuFlyoutItem Text="Abrir" Tag="{x:Bind}" Click="Open_Click" />
                                    <MenuFlyoutItem Text="Mostrar en el Explorador" Tag="{x:Bind}" Click="Reveal_Click" />
                                    <MenuFlyoutItem Text="Quitar de la Shelf" Tag="{x:Bind}" Click="Remove_Click" />
                                </MenuFlyout>
                            </Grid.ContextFlyout>

                            <StackPanel Spacing="4" HorizontalAlignment="Center" VerticalAlignment="Center">
                                <Grid Width="40" Height="40" HorizontalAlignment="Center">
                                    <Image Source="{x:Bind Thumbnail, Mode=OneWay}" Stretch="Uniform" />
                                    <FontIcon
                                        Glyph="{x:Bind FallbackGlyph, Mode=OneWay}"
                                        FontSize="28"
                                        Opacity="0.7"
                                        Visibility="{x:Bind FallbackVisibility, Mode=OneWay}" />
                                </Grid>
                                <TextBlock
                                    Width="80"
                                    FontSize="11"
                                    MaxLines="2"
                                    TextAlignment="Center"
                                    TextWrapping="Wrap"
                                    TextTrimming="CharacterEllipsis"
                                    Text="{x:Bind Name}" />
                            </StackPanel>
                        </Grid>
                    </DataTemplate>
                </muxc:ItemsRepeater.ItemTemplate>
            </muxc:ItemsRepeater>
        </ScrollViewer>

        <!-- The selection rectangle, drawn over the tiles; it never takes the pointer itself. -->
        <Canvas x:Name="MarqueeLayer" Grid.Row="1" IsHitTestVisible="False">
            <Rectangle x:Name="Marquee" Visibility="Collapsed" StrokeThickness="1" RadiusX="3" RadiusY="3" />
        </Canvas>

        <!--
            What the pointer carries while dragging files out. It is built and rendered to a bitmap
            when a drag starts, so it has to be in the tree; it sits far outside the visible area.
        -->
        <Canvas Grid.RowSpan="2" IsHitTestVisible="False">
            <Border
                x:Name="DragPreview"
                Canvas.Left="-4000"
                Canvas.Top="0"
                Padding="10,10,10,8"
                CornerRadius="10"
                Background="#E61F1F1F"
                BorderBrush="#33FFFFFF"
                BorderThickness="1"
                RequestedTheme="Dark">
                <StackPanel Spacing="6">
                    <Grid x:Name="PreviewIcons" Width="72" Height="56" HorizontalAlignment="Center" />
                    <TextBlock
                        x:Name="PreviewCaption"
                        MaxWidth="120"
                        FontSize="11"
                        TextAlignment="Center"
                        TextTrimming="CharacterEllipsis"
                        Foreground="White" />
                </StackPanel>
            </Border>
        </Canvas>
    </Grid>
</UserControl>
