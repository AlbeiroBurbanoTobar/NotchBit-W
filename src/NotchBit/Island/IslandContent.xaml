<?xml version="1.0" encoding="utf-8"?>
<UserControl
    x:Class="NotchBit.Island.IslandContent"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <!-- The island is always black, so its content is always light, whatever the system theme. -->
    <Grid RequestedTheme="Dark" Padding="20,14,20,16" RowSpacing="12">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <StackPanel x:Name="Tabs" Orientation="Horizontal" Spacing="6" />
        <ContentPresenter x:Name="Body" Grid.Row="1" />
    </Grid>
</UserControl>
