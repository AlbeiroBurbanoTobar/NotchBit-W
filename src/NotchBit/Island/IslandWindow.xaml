<?xml version="1.0" encoding="utf-8"?>
<Window
    x:Class="NotchBit.Island.IslandWindow"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    Title="NotchBit">

    <!--
        The window is transparent. At rest only a thin white line shows (like the gesture bar on a
        phone); on hover the line grows into the black island. The whole window is the hover target.
    -->
    <Grid
        x:Name="Root"
        Background="Transparent"
        AllowDrop="True"
        PointerEntered="Root_PointerEntered"
        PointerExited="Root_PointerExited"
        DragEnter="Root_DragEnter"
        DragOver="Root_DragOver"
        DragLeave="Root_DragLeave"
        Drop="Root_Drop">
        <Border
            x:Name="Pill"
            HorizontalAlignment="Center"
            VerticalAlignment="Top"
            IsHitTestVisible="False">
            <Border.Background>
                <SolidColorBrush x:Name="PillBrush" />
            </Border.Background>
            <Border.RenderTransform>
                <TranslateTransform x:Name="PillShift" />
            </Border.RenderTransform>

            <!-- Laid out at the full open size and faded in, so it never reflows while the pill grows. -->
            <Grid
                x:Name="ContentHost"
                Width="560"
                Height="200"
                HorizontalAlignment="Center"
                VerticalAlignment="Top"
                Opacity="0"
                Visibility="Collapsed" />
        </Border>
    </Grid>
</Window>
