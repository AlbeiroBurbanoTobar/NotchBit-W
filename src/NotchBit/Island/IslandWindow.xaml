<?xml version="1.0" encoding="utf-8"?>
<Window
    x:Class="NotchBit.Island.IslandWindow"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    Title="NotchBit">

    <!--
        The window is transparent. At rest only a thin white line shows (like the gesture bar on a
        phone), or a small black pill while a module has something to show; on hover it grows into
        the black island. The whole window is the hover target.
    -->
    <Grid
        x:Name="Root"
        Background="Transparent"
        AllowDrop="True"
        PointerEntered="Root_PointerEntered"
        PointerExited="Root_PointerExited"
        DragEnter="Root_DragEnter"
        DragOver="Root_DragOver"
        DragLeave="Root_DragLeave"
        Drop="Root_Drop">
        <Border
            x:Name="Pill"
            HorizontalAlignment="Center"
            VerticalAlignment="Top">
            <Border.Background>
                <SolidColorBrush x:Name="PillBrush" />
            </Border.Background>
            <Border.RenderTransform>
                <TranslateTransform x:Name="PillShift" />
            </Border.RenderTransform>

            <Grid>
                <!-- Laid out at the full open size and faded in, so it never reflows while the pill grows. -->
                <Grid
                    x:Name="ContentHost"
                    Width="560"
                    Height="230"
                    HorizontalAlignment="Center"
                    VerticalAlignment="Top"
                    Opacity="0"
                    Visibility="Collapsed" />

                <!-- What a module shows beside the resting island: left and right, with the middle left empty. -->
                <Grid
                    x:Name="CompactHost"
                    Width="240"
                    Height="32"
                    HorizontalAlignment="Center"
                    VerticalAlignment="Top"
                    Opacity="0"
                    Visibility="Collapsed">
                    <ContentPresenter x:Name="CompactLeading" HorizontalAlignment="Left" VerticalAlignment="Center" Margin="12,0,0,0" />
                    <ContentPresenter x:Name="CompactTrailing" HorizontalAlignment="Right" VerticalAlignment="Center" Margin="0,0,14,0" />
                </Grid>
            </Grid>
        </Border>
    </Grid>
</Window>
